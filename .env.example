# ===== WAJIB =====
# Minimal 32 karakter acak. Buat dengan: openssl rand -hex 32
JWT_SECRET=

# Domain CDN yang akan muncul di URL hasil upload (tanpa garis miring di akhir)
PUBLIC_BASE_URL=https://cdn.domainkamu.com

# Origin dashboard/website yang boleh memanggil API upload dari browser (pisahkan dengan koma)
# Wajib diisi di production. Ini TIDAK membatasi siapa yang boleh menampilkan file publik.
CORS_ORIGINS=https://admin.domainkamu.com

# ===== OPSIONAL =====
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DB_PATH=./data/app.db
STORAGE_DIR=./data/files

# Batas ukuran per file dan kuota total per user (MB)
MAX_FILE_MB=10
USER_QUOTA_MB=1024

# Cache browser/CDN (detik) untuk file ber-path virtual seperti /ar/voice01001.mp3.
# Tidak "immutable" karena file di path yang sama bisa ditimpa (overwrite).
PATH_CACHE_SECONDS=86400

# Halaman daftar file publik (pengganti index.php): /, /ar/, /ar_old/ ...
# Semua file ber-path virtual akan terlihat oleh siapa pun. File /f/<uuid> tidak pernah ditampilkan.
PUBLIC_INDEX=true
PUBLIC_INDEX_TITLE=Audio Library

# Token
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
JWT_ISSUER=secure-api
JWT_AUDIENCE=secure-api-clients

# Brute-force protection
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Biarkan false: user dibuat oleh admin lewat `npm run user:create`
ALLOW_REGISTRATION=false

# Set true HANYA jika API berada di belakang reverse proxy/CDN tepercaya (Nginx, Cloudflare)
# agar rate limit membaca IP asli dari X-Forwarded-For
TRUST_PROXY=false
